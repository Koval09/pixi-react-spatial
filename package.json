{
  "name": "pixi-react-spatial",
  "version": "0.1.0",
  "description": "Declarative 2D camera, quadtree culling, and Pixi-world <-> DOM synchronization for @pixi/react v8",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "pixi",
    "react",
    "pixijs",
    "camera",
    "quadtree",
    "culling",
    "viewport",
    "portal"
  ],
  "author": "Koval09",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "pixi.js": ">=8.0.0",
    "@pixi/react": ">=8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@pixi/react": "^8.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
